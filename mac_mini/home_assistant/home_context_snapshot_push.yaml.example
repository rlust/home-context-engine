              "button.family_room_aqara_presence_multi_sensor_fp300_ai_spatial_learning": {'state': states.button.family_room_aqara_presence_multi_sensor_fp300_ai_spatial_learning.state, 'last_changed': states.button.family_room_aqara_presence_multi_sensor_fp300_ai_spatial_learning.last_changed.isoformat(), 'last_reported': states.button.family_room_aqara_presence_multi_sensor_fp300_ai_spatial_learning.last_reported.isoformat()},
              "button.family_room_aqara_presence_multi_sensor_fp300_restart_device": {'state': states.button.family_room_aqara_presence_multi_sensor_fp300_restart_device.state, 'last_changed': states.button.family_room_aqara_presence_multi_sensor_fp300_restart_device.last_changed.isoformat(), 'last_reported': states.button.family_room_aqara_presence_multi_sensor_fp300_restart_device.last_reported.isoformat()},
